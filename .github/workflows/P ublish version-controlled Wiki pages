      - name: Publish version-controlled Wiki pages
        env:
          WIKI_PUSH_TOKEN: ${{ secrets.WIKI_PUSH_TOKEN }}
          GIT_TERMINAL_PROMPT: "0"
        run: |
          set -euo pipefail
          
          # Clone using x-access-token in the URL
          git clone "https://x-access-token:${WIKI_PUSH_TOKEN}@github.com/${GITHUB_REPOSITORY}.wiki.git" wiki-publish
          
          rsync -av --exclude=.git docs/wiki/ wiki-publish/
          cd wiki-publish
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          
          if git diff --cached --quiet; then
            echo "Wiki is already up to date."
            exit 0
          fi
          
          git commit -m "Publish Wiki from ${GITHUB_SHA}"
          git push origin HEAD
